# Renance study-api, copy to apps/study-api/.env (gitignored) for local runs.
# scripts/study-api-dev.sh fills these automatically for sandbox/dev use.

# Postgres DSN. Production: the Neon POOLED URI from the console
# (…-pooler….neon.tech/neondb?sslmode=require), channel_binding is stripped
# automatically because pgx has no channel-binding support.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres?sslmode=disable

# Database fallback chain (founder directive 2026-10-15): when the
# primary DSN is unreachable at boot, the service walks these in order
# and migrates + seeds the winner automatically. Optional.
# SUPABASE_DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# INSFORGE_DATABASE_URL=postgresql://postgres:API-KEY@REF.REGION.database.insforge.app:5432/insforge?sslmode=require
# FALLBACK_DATABASE_URLS=  # explicit ordered chain, overrides the two above
# DB_FAIL_EXIT=0           # kill switch: never exit on a database-down verdict

# HS256 signing secret, >= 16 chars. Generate: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789

# Port the HTTP server binds. Render/Fly inject their own, honored.
PORT=3990

# CORS allowlist (comma-separated). "*" keeps local dev wide open.
WEB_ORIGIN=*

# Google Identity Services audience (web OAuth client ID). Unset = the
# POST /auth/google endpoint answers 503 google_disabled.
# GOOGLE_CLIENT_ID=850087098854-pni8gohld0isi8v8nhhnlcl5fuvi77q4.apps.googleusercontent.com

# Content library dir (auto-discovered by walking up to data/manifest.json).
# DATA_DIR=

# Grading engine tuning.
GRADE_WORKERS=8
GRADE_QUEUE=1024

# AI tutor + AI question generator (ROADMAP #9 + founder directive 2026-09).
# The provider defaults to Gemini's OpenAI-compatible surface; paste the
# founder's Gemini API key here (GitHub push protection rightly refuses it
# inside the repo, so it rides the environment only).
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.6-flash
# AI_MAX_TOKENS=320
