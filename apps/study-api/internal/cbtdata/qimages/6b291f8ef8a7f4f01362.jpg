on",[14,18,29],"collection_id",false,{"search_column":7,"model":32,"title":33},"Modules\\Events\\Entities\\Event","Events",{"search_column":7,"model":35,"title":36},"Modules\\Materials\\Entities\\Material","Research Materials",{"search_column":7,"model":38,"title":39,"select":40},"Modules\\Groups\\Entities\\Group","Groups",[14,7,15,41],"image",{"search_column":7,"model":43,"title":44,"select":45},"Modules\\ClassifiedAds\\Entities\\ClassifiedAds","Marketplace",[14,15,7,46],"price",[48,55,61,67,73],{"id":49,"keyword":50,"count":51,"last_searched_at":52,"created_at":53,"updated_at":54},48,"neco 2026 ssce (internal) examination timetable",1325,"2026-09-08 06:04:26","2026-06-20 19:16:04",null,{"id":56,"keyword":57,"count":58,"last_searched_at":59,"created_at":60,"updated_at":54},2340,"my-school",1155,"2026-09-08 08:40:43","2026-06-24 07:40:04",{"id":62,"keyword":63,"count":64,"last_searched_at":65,"created_at":66,"updated_at":54},551528,"state legislature session today",1021,"2026-09-06 19:19:03","2026-07-26 13:19:35",{"id":68,"keyword":69,"count":70,"last_searched_at":71,"created_at":72,"updated_at":54},5,"jamb",937,"2026-09-08 05:48:49","2026-03-27 18:16:02",{"id":74,"keyword":75,"count":76,"last_searched_at":77,"created_at":78,"updated_at":54},2084,"admission",849,"2026-09-08 04:16:06","2026-06-24 07:06:28",{"status":80,"message":81,"data":82},1,"",{"id":83,"tag":84,"randomize":80,"num_ad_blocks":68,"layout":85,"adverts":86},46,"header_premium","vert",[],["Reactive",88],{"$spreviousRoute":89},"\u002F404?page=https%253A%252F%252Fmyschool.ng%252Fstorage%252Fclassroom%252FgczgLcXb9yTBd3kUxAqEE9Xdg97OoP2Zz4md7BMi.jpeg",["Set"],["ShallowReactive",92],{"popular-searches":-1,"notification-count":93,"adverts-section-header_premium":-1,"pages-404":98,"filter-data":-1},["NuxtError",94],{"message":95,"statusCode":96,"statusMessage":95,"data":97},"Unauthenticated.",401,{"success":30,"message":95},["NuxtError",99],{"message":100,"statusCode":101,"statusMessage":100,"data":102},"Page not found",404,{"message":100},true,["Reactive",105],{"auth":106,"cart":111,"global_state":113,"recent-search":118,"customization":121},{"user":107,"token":109,"completed_setups":110},["EmptyRef",108],"_",["EmptyRef",108],[],{"cart":112,"bynowCart":-1},[],{"loadingElements":114,"isUILoading":30,"isReporting":30,"toggleElements":115,"isToggle":30,"modalData":-1,"notificationCount":116},{},{},{"friend_notification_count":117,"inbox_notification_count":117,"comment_notification_count":117},0,{"recentSearches":119,"popularSearches":120},[],[],{"simulators":122,"feeds":176,"profiles":227,"removedNewsCategories":228},[123,134,145,155,165],{"id":80,"title":124,"description":125,"page":126,"tags":127,"simulator":131,"link":132,"selected":103,"image":133,"order":117},"CBT Simulator","Create and set up a CBT environment to practice for any CBT exam.","Create and practice in a real computer-based testing environment for any exam. Customize subjects, set timing, and take unlimited mock tests just like the real thing. Also great for school exams, professional tests, scholarships, etc.",[128,129,130],"Customizable","Mock Tests","All Exams","cbt","\u002Fclassroom\u002Fexam\u002Fcbt","\u002Fimages\u002Fcustom.png",{"id":135,"title":136,"description":137,"page":138,"tags":139,"simulator":69,"link":143,"selected":103,"image":144,"order":80},2,"JAMB CBT Simulator","Practice JAMB CBT with real UTME past questions in CBT format.","Prepare for JAMB UTME with a realistic CBT platform that mirrors the official exam environment. Practice with authentic past questions, timed mock tests, and performance analysis to boost your score.",[140,141,142],"JAMB","UTME","Past Questions","\u002Fclassroom\u002Fexam\u002Fjamb","\u002Fimages\u002Fjamb.png",{"id":146,"title":147,"description":148,"page":149,"tags":150,"simulator":152,"link":153,"selected":103,"image":154,"order":135},3,"WAEC CBT Practice 2026 Simulator","Practice WAEC past questions in a real CBT exam environment.","Practice WAEC CBT, also known as CB-WASSCE, with this Simulator. You can prepare for both the 2026 SSCE and GCE using this tool. Practice with real WAEC past questions in a timed, computer-based environment, track your performance, and master the subjects that matter most.",[151,142],"WAEC","waec","\u002Fclassroom\u002Fexam\u002Fwaec","\u002Fimages\u002Fwaec.png",{"id":156,"title":157,"description":158,"page":159,"tags":160,"simulator":162,"link":163,"selected":103,"image":164,"order":146},4,"NECO CBT Practice 2026 Simulator","Prepare for 2026 NECO exams using real past questions in CBT mode.","Practice NECO CBT and Master your NECO exam preparation with this powerful simulator. With this CBT app, you can take test to prepare for both the 2026 SSCE and GCE. Take mock exams with real past questions, experience timed practice sessions, and review detailed solutions to improve performance.",[161,142],"NECO","neco","\u002Fclassroom\u002Fexam\u002Fneco","\u002Fimages\u002Fneco.png",{"id":68,"title":166,"description":167,"page":168,"tags":169,"simulator":173,"link":174,"selected":30,"image":175,"order":156},"Challenge Simulator","Compete against other students and climb Myschool's Leaderboard.","Compete with other Myschoolers in real-time CBT challenges, climb the Myschool leaderboard, and even win exciting prizes. The Challenge Simulator turns exam prep into a competition where you test your skills and earn recognition.",[170,171,172],"Challenge","Leaderboard","Competition","challenge","\u002Fclassroom\u002Fexam\u002Fchallenge","\u002Fimages\u002Fchallenge.png",[177,180,184,187,190,193,197,201,205,207,211,214,217,220,224],{"id":80,"value":178,"label":179,"selected":103},"latest_news","Latest News",{"id":181,"value":182,"label":183,"selected":103},12,"featured_stories","Featured Stories",{"id":135,"value":185,"label":186,"selected":103},"top_stories","Hot Stories",{"id":156,"value":188,"label":189,"selected":103},"scholarships","Scholarships",{"id":68,"value":191,"label":192,"selected":103},