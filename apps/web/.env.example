# apps/web - local environment (gitignored: .env.local).
# Copy to .env.local and fill real values; never commit them.
# The NEXT_PUBLIC_ prefix is REQUIRED in a static export: the values are
# baked into the browser bundle at build time.

# The Go study-api base (local dev: the Go server on :3990).
NEXT_PUBLIC_API_BASE="http://localhost:3990"

# Supabase (founder directive 2026-10-15) - browser-side client +
# activity ping. Publishable (anon) key ONLY here: it is public by
# design and its powers are bounded by RLS.
NEXT_PUBLIC_SUPABASE_URL="https://zfxrmcwdnmmxjawmsiyp.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_PUT-YOUR-KEY-HERE"
