{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "sh ../../scripts/vercel-build.sh",
  "outputDirectory": "out",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/pdfs/:path*",
      "destination": "https://resolutefemi.github.io/Renance/pdfs/:path*"
    }
  ],
  "headers": [
    {
      "source": "/bundles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
