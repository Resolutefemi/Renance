<?xml version="1.0" encoding="utf-8"?>
<!-- The 3D FLAT keycap, adaptive: day ground white, night ground the
     fixed near-black (#0f1216) via values-night - the icon adapts to
     appearance exactly like the website favicon. The monochrome layer
     powers the Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
