<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Release APK must reach the study API (debug/profile had this via the
         default Flutter template; the main manifest did not). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Downloads: connection awareness (Wi-Fi vs mobile data) so the
         Downloads screen can honour the "Wi-Fi only" preference. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- Storage: Android 11+ apps write offline packs to app-specific
         directories that need NO runtime grant, but Android 10 and below
         still use legacy shared storage for shared pack exports. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <!-- Download progress + sync notifications (Android 13+ runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Renance"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <!-- CRASH FIX (2026-10-23, "Renance keeps stopping"): the pass-IX
             activity-alias launcher pair (.LauncherLight/.LauncherDark) is
             GONE. MIUI's launcher reacts to PackageManager component-state
             changes by stopping the app's process (DONT_KILL_APP is a
             hint it ignores), and repeated startup mutations left the
             alias launch path broken on the founder's device even after
             the mutations were guarded. The launcher entry is back where
             every known-good build (<= 28) had it: directly on
             .MainActivity, with the standard adaptive icon that MIUI
             handles through plain resources - no PackageManager
             round-trips at launch, ever. The deep-link filter stays. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="renance"/>
            </intent-filter>
        </activity>
        <!-- The home-screen streak widget (founder 2026-10-22, the
             Duolingo widget pass): Dart pushes the count through
             home_widget; this receiver repaints the tile. -->
        <receiver
            android:name=".StreakWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/streak_widget_info"/>
        </receiver>
        <!-- BOOT-CRASH FIX, round 2 (2026-10-23) - the REAL root cause of
             "Renance keeps stopping" on 30/31/32. home_widget pulls
             androidx.glance:glance-appwidget 1.0.0, which drags in
             androidx.work 2.7.1 (+ Room 2.2.5). work-runtime's manifest
             auto-initializes WorkManager through androidx.startup during
             ContentProvider install - BEFORE Application.onCreate, before
             MainActivity, before any Dart code. Under R8 full-mode shrinking
             WorkDatabase_Impl keeps its name but loses its never-statically-
             called constructor, so Room's reflective
             getDeclaredConstructor().newInstance() always throws
             "Failed to create an instance of androidx.work.impl.WorkDatabase"
             and the process dies on EVERY launch, on EVERY device.
             Nothing in this app uses WorkManager (home_widget's source never
             references it, the streak widget is a plain RemoteViews provider,
             local notifications use AlarmManager), so the auto-initializer
             is removed from the merged manifest. WorkManager's classes stay
             in the APK; it simply never boots. See also proguard-rules.pro. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
