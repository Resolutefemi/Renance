# ============================================================
#  Renance - local development environment
#  cp .env.example .env     (then fill values; NEVER commit .env)
# ============================================================

# ---- runtime -----------------------------------------------
APP_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ---- database: Neon Postgres -------------------------------
# Pooled connection for APP RUNTIME (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection for MIGRATIONS / drizzle-kit (non-pooler host)
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- cache / queues (needed from Phase 3) ------------------
REDIS_URL="redis://localhost:6379"

# ---- auth secrets (Phase 1) --------------------------------
JWT_SECRET="change-me-to-a-long-random-string"

# ---- object storage: Cloudflare R2 (Phase 2+) --------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PUBLIC=""

# ---- payments (Phase 3) ------------------------------------
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxx"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxx"

# ---- push notifications: FCM (Phase 2+) --------------------
FCM_SERVER_KEY=""

# ---- web app ------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
