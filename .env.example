# ============================================================
#  Renance Study OS (ERA-2) — local development environment
#  cp .env.example .env     (then fill values; NEVER commit .env)
# ============================================================

# ---- database -----------------------------------------------
# Neon Postgres or any Postgres. Pooled URI is fine — the Go service
# uses simple-protocol mode, safe behind transaction-mode poolers.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- study-api (Go, apps/study-api) -------------------------
PORT=3990
JWT_SECRET="change-me-to-a-long-random-string"
DATA_DIR="data"          # defaults to the repo-root data/ dir
WEB_ORIGIN="*"           # Next.js origin for CORS in dev

# ---- web (apps/web) -----------------------------------------
NEXT_PUBLIC_API_BASE="http://localhost:3990"
NEXT_PUBLIC_SITE_URL="https://renance.vercel.app"
