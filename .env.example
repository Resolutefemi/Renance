# ============================================================
#  Renance Study OS (ERA-2), local development environment
#  cp .env.example .env     (then fill values; NEVER commit .env)
# ============================================================

# ---- database -----------------------------------------------
# Neon Postgres or any Postgres. Pooled URI is fine, the Go service
# uses simple-protocol mode, safe behind transaction-mode poolers.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- database fallback (founder directive 2026-10-15) ----------
# When DATABASE_URL (Neon) is unreachable at boot - free tier
# suspended, allowance spent - the Go API walks this chain in order
# and boots on the first live DSN. Migrations + the curriculum seed
# run on the winner automatically, so a fallback needs no prep.
#
# Fill the two named fallbacks (order: Supabase, then InsForge), or
# set FALLBACK_DATABASE_URLS to an explicit comma-separated chain
# (which overrides the two named vars). All optional.
#
# VERIFIED LIVE VALUES for this repo's projects (2026-10-15, see
# apps/study-api/.env which carries the real DSNs gitignored):
#   Supabase session-mode pooler (IPv4-safe; the direct
#   db.<ref>.supabase.co host is IPv6-only):
#     postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require
#   InsForge:
#     postgresql://postgres:<API-KEY>@<PROJECT-REF>.<REGION>.database.insforge.app:5432/insforge?sslmode=require
SUPABASE_DATABASE_URL="postgresql://postgres.PROJECT-REF:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require"
INSFORGE_DATABASE_URL="postgresql://postgres:API-KEY@PROJECT-REF.REGION.database.insforge.app:5432/insforge?sslmode=require"
# FALLBACK_DATABASE_URLS="postgresql://...,postgresql://..."

# Prepare a fallback ahead of time (optional - a failover boot also
# provisions it):
#   cd apps/study-api && go run ./cmd/dbapply -dsn "$SUPABASE_DATABASE_URL"
# The tool structurally refuses any neon.tech DSN unless -force-neon.

# ---- dual-write mirror (founder directive 2026-10-15) ----------
# "everything should save simultaneously on both neon and Supabase
# at once": every write the PRIMARY accepts replays asynchronously to
# every mirror DSN behind it in the chain (Supabase, then InsForge).
# The boot sync additionally copies any rows a mirror is missing
# (accounts, progress - a bidirectional missing-row merge), so the
# first boot after enabling this copies the live users off the
# primary. Run history is visible in both dashboards: the
# public.mirror_sync table next to db_keepalive.
#   MIRROR_WRITES=0 -> no mirror connections, classic single pool.
#   MIRROR_SYNC=0   -> writes still mirror, no boot row-merge.
#MIRROR_WRITES=1
#MIRROR_SYNC=1

# ---- study-api (Go, apps/study-api) -------------------------
PORT=3990
JWT_SECRET="change-me-to-a-long-random-string"
DATA_DIR="data"          # defaults to the repo-root data/ dir
WEB_ORIGIN="*"           # Next.js origin for CORS in dev

# ---- arena (ROADMAP #14, optional; defaults shown) -----------
ARENA_QUESTIONS=5
ARENA_SECONDS_PER_QUESTION=15
ARENA_INTRO_SECONDS=3
ARENA_BOT_WAIT_SECONDS=20
ARENA_ROOM_TTL_SECONDS=900
ARENA_BOT_SKILL=0.6

# ---- web (apps/web) -----------------------------------------
NEXT_PUBLIC_API_BASE="http://localhost:3990"
NEXT_PUBLIC_SITE_URL="https://renance.vercel.app"

# ---- google sign-in ------------------------------------------
# Public OAuth client IDs (safe to commit, no secrets involved).
# WEB id goes to the Next.js build; BOTH ids (comma-separated) go to
# the Go API so it can verify tokens from web + mobile clients.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="850087098854-pni8gohld0isi8v8nhhnlcl5fuvi77q4.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="850087098854-pni8gohld0isi8v8nhhnlcl5fuvi77q4.apps.googleusercontent.com,850087098854-5rj3vig6fpm4k2jie4najsoq6tpcdm6f.apps.googleusercontent.com"
# GCP console checklist when you see "Error 401: invalid_client":
#   1. APIs & Services -> Credentials -> the WEB OAuth client ->
#      Authorized JavaScript origins must include the exact deployment
#      origin (https://<owner>.github.io) + http://localhost:3000.
#   2. OAuth consent screen -> Publishing status "In production".
#   3. Use the WEB client id on web, the ANDROID id on mobile, never swap.
