{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "apps/web/out",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/u/:username/",
      "destination": "/profile/view/?u=:username"
    },
    {
      "source": "/u/:username",
      "destination": "/profile/view/?u=:username"
    },
    {
      "source": "/api/app-version",
      "destination": "https://renance-api.onrender.com/app-version"
    },
    {
      "source": "/api/:path*/",
      "destination": "https://renance-api.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://renance-api.onrender.com/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/practice/:body/english-language/",
      "destination": "/practice/:body/english/",
      "permanent": true
    },
    {
      "source": "/practice/:body/english-language/:year/",
      "destination": "/practice/:body/english/:year/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://accounts.google.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' wss://renance.app https://zfxrmcwdnmmxjawmsiyp.supabase.co https://accounts.google.com https://oauth2.googleapis.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/bundles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/pdfs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/school-corpus/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
