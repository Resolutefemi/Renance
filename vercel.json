{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "python3 scripts/web_bundles.py && pnpm --filter @renance/web exec next build",
  "outputDirectory": "apps/web/out",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://renance-api.onrender.com/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_BASE_PATH": "",
    "NEXT_PUBLIC_API_BASE": "/api",
    "NEXT_PUBLIC_SITE_URL": "https://renance.vercel.app"
  },
  "headers": [
    {
      "source": "/bundles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
