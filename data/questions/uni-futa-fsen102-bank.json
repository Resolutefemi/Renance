SB and CF)","B":"Shifts left","C":"Rotates through carry","D":"Does nothing"},"marks":1},{"id":"uni-futa-fsen102-0130","type":"mcq","stem":"ROR AX, 1 does what?","options":{"A":"Rotates AX right by 1 (LSB goes to MSB and CF)","B":"Shifts right","C":"Rotates through carry","D":"Does nothing"},"marks":1},{"id":"uni-futa-fsen102-0131","type":"mcq","stem":"RCL AX, 1 does what?","options":{"A":"Rotates left through carry (9-bit rotation)","B":"Rotates left without carry","C":"Shifts left through carry","D":"Does nothing"},"marks":1},{"id":"uni-futa-fsen102-0132","type":"mcq","stem":"RCR AX, 1 does what?","options":{"A":"Rotates right through carry","B":"Rotates right without carry","C":"Shifts right through carry","D":"Does nothing"},"marks":1},{"id":"uni-futa-fsen102-0133","type":"mcq","stem":"PUSHF pushes which register onto the stack?","options":{"A":"AX","B":"FLAGS","C":"IP","D":"CS"},"marks":1},{"id":"uni-futa-fsen102-0134","type":"mcq","stem":"POPF does what?","options":{"A":"Pops AX from stack","B":"Pops FLAGS from stack into the FLAGS register","C":"Pops IP from stack","D":"Pops CS from stack"},"marks":1},{"id":"uni-futa-fsen102-0135","type":"mcq","stem":"The CALL instruction does what?","options":{"A":"Jumps to a subroutine and pushes the return address","B":"Only jumps","C":"Pushes flags","D":"Pops the stack"},"marks":1},{"id":"uni-futa-fsen102-0136","type":"mcq","stem":"The RET instruction does what?","options":{"A":"Pushes the return address","B":"Pops the return address from stack into CS:IP","C":"Clears the stack","D":"Does nothing"},"marks":1},{"id":"uni-futa-fsen102-0137","type":"mcq","stem":"A near CALL pushes how many bytes?","options":{"A":"1 byte","B":"2 bytes (IP only)","C":"4 bytes (CS:IP)","D":"8 bytes"},"marks":1},{"id":"uni-futa-fsen102-0138","type":"mcq","stem":"A far CALL pushes how many bytes?","options":{"A":"2 bytes","B":"4 bytes (CS and IP)","C":"6 bytes","D":"8 bytes"},"marks":1},{"id":"uni-futa-fsen102-0139","type":"mcq","stem":"RET 4 does what?","options":{"A":"Returns and pops 4 extra bytes from stack","B":"Returns 4 times","C":"Returns to address 4","D":"Does nothing special"},"marks":1},{"id":"uni-futa-fsen102-0140","type":"mcq","stem":"INT 21h is commonly used for:","options":{"A":"Arithmetic","B":"DOS function calls","C":"Hardware interrupts","D":"Stack operations"},"marks":1},{"id":"uni-futa-fsen102-0141","type":"mcq","stem":"Which INT 21h function displays a string?","options":{"A":"AH=01h","B":"AH=09h","C":"AH=4Ch","D":"AH=00h"},"marks":1},{"id":"uni-futa-fsen102-0142","type":"mcq","stem":"Which INT 21h function terminates a program?","options":{"A":"AH=01h","B":"AH=09h","C":"AH=4Ch","D":"AH=0Ah"},"marks":1},{"id":"uni-futa-fsen102-0143","type":"mcq","stem":"Which INT 21h function reads a character from keyboard?","options":{"A":"AH=01h","B":"AH=02h","C":"AH=09h","D":"AH=4Ch"},"marks":1},{"id":"uni-futa-fsen102-0144","type":"mcq","stem":"Which INT 21h function displays a single character?","options":{"A":"AH=01h","B":"AH=02h","C":"AH=09h","D":"AH=0Ah"},"marks":1},{"id":"uni-futa-fsen102-0145","type":"mcq","stem":"In INT 21h AH=09h, the string must be terminated by:","options":{"A":"Null byte (00h)","B":"Dollar sign ($)","C":"Newline (0Ah)","D":"Zero (0)"},"marks":1},{"id":"uni-futa-fsen102-0146","type":"mcq","stem":"IRET (Interrupt Return) pops how many items from the stack?","options":{"A":"1 (IP only)","B":"2 (IP and CS)","C":"3 (IP, CS, and FLAGS)","D":"4 items"},"marks":1},{"id":"uni-futa-fsen102-0147","type":"mcq","stem":"The STI instruction does what?","options":{"A":"Disables interrupts (clears IF)","B":"Enables interrupts (sets IF)","C":"Sends an interrupt","D":"Clears the stack"},"marks":1},{"id":"uni-futa-fsen102-0148","type":"mcq","stem":"The CLI instruction does what?","options":{"A":"Enables interrupts","B":"Disables interrupts (clears IF)","C":"Triggers an interrupt","D":"Clears flags"},"marks":1},{"id":"uni-futa-fsen102-0149","type":"mcq","stem":"The CLC instruction does what?","options":{"A":"Sets CF","B":"Clears CF (Carry Flag)","C":"Clears all flags","D":"Sets all flags"},"marks":1},{"id":"uni-futa-fsen102-0150","type":"mcq","stem":"The STC instruction does what?","options":{"A":"Clears CF","B":"Sets CF (Carry Flag = 1)","C":"Sets all flags","D":"Clears ZF"},"marks":1},{"id":"uni-futa-fsen102-0151","type":"mcq","stem":"The CMC instruction does what?","options":{"A":"Clears CF","B":"Sets CF","C":"Complements (inverts) CF","D":"Does nothing to CF"},"marks":1},{"id":"uni-futa-fsen102-0152","type":"mcq","stem":"LAHF and SAHF transfer flags between:","options":{"A":"AX and FLAGS","B":"AH and lower byte of FLAGS","C":"AL and FLAGS","D":"DX and FLAGS"},"marks":1},{"id":"uni-futa-fsen102-0153","type":"mcq","stem":"MOVSB copies a byte from:","options":{"A":"DS:SI to ES:DI","B":"ES:DI to DS:SI","C":"CS:IP to DS:SI","D":"SS:SP to DS:SI"},"marks":1},{"id":"uni-futa-fsen102-0154","type":"mcq","stem":"MOVSW copies how many bytes?","options":{"A":"1 byte","B":"2 bytes (one word)","C":"4 bytes","D":"Variable"},"marks":1},{"id":"uni-futa-fsen102-0155","type":"mcq","stem":"When DF=0, string instructions auto-___ SI and DI.","options":{"A":"Decrement","B":"Increment","C":"Do not change","D":"Set to zero"},"marks":1},{"id":"uni-futa-fsen102-0156","type":"mcq","stem":"When DF=1, string instructions auto-___ SI and DI.","options":{"A":"Increment","B":"Decrement","C":"Do not change","D":"Set to zero"},"marks":1},{"id":"uni-futa-fsen102-0157","type":"mcq","stem":"The CLD instruction does what?","options":{"A":"Sets DF (backward)","B":"Clears DF (forward)","C":"Does nothing","D":"Clears all flags"},"marks":1},{"id":"uni-futa-fsen102-0158","type":"mcq","stem":"The STD instruction does what?","options":{"A":"Clears DF","B":"Sets DF (backward direction)","C":"Does nothing","D":"Sets all flags"},"marks":1},{"id":"uni-futa-fsen102-0159","type":"mcq","stem":"The REP prefix repeats a string instruction:","options":{"A":"Once","B":"Until CX=0","C":"Until ZF=1","D":"Until DF=0"},"marks":1},{"id":"uni-futa-fsen102-0160","type":"mcq","stem":"REPE (or REPZ) repeats while:","options":{"A":"CX≠0 and ZF=1","B":"CX≠0 and ZF=0","C":"CX=0","D":"ZF=1 only"},"marks":1},{"id":"uni-futa-fsen102-0161","type":"mcq","stem":"REPNE (or REPNZ) repeats while:","options":{"A":"CX≠0 and ZF=1","B":"CX≠0 and ZF=0","C":"CX=0","D":"ZF=0 only"},"marks":1},{"id":"uni-futa-fsen102-0162","type":"mcq","stem":"CMPSB compares:","options":{"A":"Byte at DS:SI with byte at ES:DI","B":"AX with BX","C":"Two registers","D":"Two immediate values"},"marks":1},{"id":"uni-futa-fsen102-0163","type":"mcq","stem":"SCASB scans a string by comparing:","options":{"A":"AL with byte at ES:DI","B":"AX with ES:DI","C":"BL with DS:SI","D":"AL with DS:SI"},"marks":1},{"id":"uni-futa-fsen102-0164","type":"mcq","stem":"LODSB loads a byte from:","options":{"A":"ES:DI into AL","B":"DS:SI into AL","C":"Stack into AL","D":"I/O port into AL"},"marks":1},{"id":"uni-futa-fsen102-0165","type":"mcq","stem":"STOSB stores a byte from:","options":{"A":"AL to ES:DI","B":"AL to DS:SI","C":"AL to SS:SP","D":"AL to CS:IP"},"marks":1},{"id":"uni-futa-fsen102-0166","type":"mcq","stem":"To copy a 100-byte string, you would use:","options":{"A":"REP MOVSB with CX=100","B":"LOOP MOVSB","C":"100 MOVSB instructions","D":"REP with AX=100"},"marks":1},{"id":"uni-futa-fsen102-0167","type":"mcq","stem":"To fill 50 bytes of memory with 0, you would use:","options":{"A":"REP STOSB with CX=50, AL=0","B":"REP MOVSB","C":"LOOP with MOV","D":"REP LODSB"},"marks":1},{"id":"uni-futa-fsen102-0168","type":"mcq","stem":"REPNE SCASB is typically used for:","options":{"A":"String copy","B":"Searching for a character in a string","C":"String comparison","D":"Filling memory"},"marks":1},{"id":"uni-futa-fsen102-0169","type":"mcq","stem":"After REPNE SCASB finds a match, DI points to:","options":{"A":"The matching byte","B":"One byte after the match","C":"The start of the string","D":"The end of the string"},"marks":1},{"id":"uni-futa-fsen102-0170","type":"mcq","stem":"MOVSB adjusts SI and DI by:","options":{"A":"1 (when DF=0)","B":"2 (when DF=0)","C":"4","D":"Depends on operand size"},"marks":1},{"id":"uni-futa-fsen102-0171","type":"mcq","stem":"MOVSW adjusts SI and DI by:","options":{"A":"1","B":"2 (when DF=0)","C":"4","D":"8"},"marks":1},{"id":"uni-futa-fsen102-0172","type":"mcq","stem":"Before using string instructions, what must be set up?","options":{"A":"Only DS","B":"DS and ES (for MOVSB/CMPSB)","C":"CS and SS","D":"Only ES"},"marks":1},{"id":"uni-futa-fsen102-0173","type":"mcq","stem":"In 8086 assembly, comments start with:","options":{"A":"//","B":"#","C":";","D":"--"},"marks":1},{"id":"uni-futa-fsen102-0174","type":"mcq","stem":"A program that prints 'Hello World' uses which DOS interrupt?","options":{"A":"INT 10h","B":"INT 21h with AH=09h","C":"INT 20h","D":"INT 16h"},"marks":1},{"id":"uni-futa-fsen102-0175","type":"mcq","stem":"The .MODEL directive specifies:","options":{"A":"The processor type","B":"The memory model (small, medium, large, etc.)","C":"The assembler version","D":"The output format"},"marks":1},{"id":"uni-futa-fsen102-0176","type":"mcq","stem":"The .DATA segment directive defines:","options":{"A":"The code segment","B":"The data segment (variables)","C":"The stack segment","D":"The extra segment"},"marks":1},{"id":"uni-futa-fsen102-0177","type":"mcq","stem":"The .CODE segment directive defines:","options":{"A":"The data segment","B":"The code segment (instructions)","C":"The stack segment","D":"The extra segment"},"marks":1},{"id":"uni-futa-fsen102-0178","type":"mcq","stem":"The .STACK directive reserves:","options":{"A":"Code space","B":"Stack space (e.g., .STACK 100h reserves 256 bytes)","C":"Data space","D":"I/O space"},"marks":1},{"id":"uni-futa-fsen102-0179","type":"mcq","stem":"To declare a byte variable named 'count' with value 5:","options":{"A":"count DB 5","B":"count DW 5","C":"count DD 5","D":"count BYTE 5"},"marks":1},{"id":"uni-futa-fsen102-0180",