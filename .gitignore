# dependencies / builds
node_modules/
dist/
build/
out/
.next/
.turbo/
coverage/

# environment — NEVER commit real secrets
.env
.env.local
.env.*.local

# logs & misc
*.log
pnpm-debug.log*
.DS_Store

# flutter / dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec.lock

# editors
.idea/
.vscode/*
