!.vscode/settings.json

# study-api (Go)
apps/study-api/study-api
apps/study-api/bin/

# CBT answer keys are SERVER-ONLY (ADR-0003). Mock keys are the sole
# tracked exception — real bank keys must never enter the repo.
data/answer-keys/*
!data/answer-keys/mock/

# Build-provenance copies of harvested source banks (with answers) are
# kept on disk only — the packed student-safe artifacts live in
# data/questions/. Never commit the raw sources.
data/src/real/
data/src/mock/

# theme-flip golden renders (regenerable via --update-goldens)
apps/mobile/test/goldens/
arena-e2e
